{
  "name": "jjinmak",
  "productName": "찐막",
  "version": "0.1.1",
  "private": true,
  "description": "찐막 macOS / Windows 모노레포",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node scripts/launch.cjs",
    "start:mac": "npm run start --workspace=@jjinmak/macos",
    "start:win": "npm run start --workspace=@jjinmak/windows",
    "demo": "node scripts/launch.cjs --demo",
    "demo:mac": "npm run demo --workspace=@jjinmak/macos",
    "demo:win": "npm run demo --workspace=@jjinmak/windows",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/smoke-ui.cjs",
    "package:win": "node scripts/package.mjs windows",
    "package:mac": "node scripts/package.mjs macos",
    "package:mac:intel": "node scripts/package.mjs macos x64"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.3.0",
    "playwright": "1.63.0"
  }
}
